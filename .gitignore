# Tidal — root-level download folder only (not Next.js route dirs)
/downloads/
music/

# SQLite — bases de datos locales de desarrollo
*.db
*.sqlite3
*.db.bak

# Muestras de audio para analisis de espectrograma (Spek) — no versionar
spek_samples/

# Scripts de investigacion/verificacion locales (probes de calidad, PKCE, Android
